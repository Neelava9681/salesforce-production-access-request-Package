    <textTemplates>
        <name>AcknowledgeEmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;div style=&quot;margin:0; padding:0; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif; color:#2f3a45;&quot;&gt;

  &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; width=&quot;100%&quot; style=&quot;background-color:#f4f6f8;&quot;&gt;
    &lt;tr&gt;
      &lt;td align=&quot;center&quot; style=&quot;padding:30px 15px;&quot;&gt;

        &lt;!-- Main Card --&gt;
        &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; width=&quot;100%&quot;
               style=&quot;max-width:650px; background-color:#ffffff; border-radius:10px; overflow:hidden;&quot;&gt;

          &lt;!-- Header --&gt;
          &lt;tr&gt;
            &lt;td style=&quot;background-color:#17365d; padding:24px 30px; text-align:center;&quot;&gt;
              &lt;div style=&quot;font-size:22px; line-height:30px; font-weight:bold; color:#ffffff;&quot;&gt;
                Production Access Request
              &lt;/div&gt;
              &lt;div style=&quot;font-size:13px; line-height:20px; color:#dbe7f5; margin-top:5px;&quot;&gt;
                {!Get_Production_Access_Config.Project_Name__c}
              &lt;/div&gt;
            &lt;/td&gt;
          &lt;/tr&gt;

          &lt;!-- Content --&gt;
          &lt;tr&gt;
            &lt;td style=&quot;padding:30px;&quot;&gt;

              &lt;p style=&quot;margin:0 0 18px 0; font-size:15px; line-height:24px;&quot;&gt;
                Hello &lt;strong&gt;{!DefaultDeveloperName}&lt;/strong&gt;,
              &lt;/p&gt;

              &lt;p style=&quot;margin:0 0 18px 0; font-size:15px; line-height:24px;&quot;&gt;
                Your request for temporary Production Access has been
                &lt;strong&gt;successfully submitted&lt;/strong&gt;.
              &lt;/p&gt;

              &lt;!-- Status Message --&gt;
              &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; width=&quot;100%&quot;
                     style=&quot;margin:20px 0 25px 0; background-color:#f1f7ff; border-left:4px solid #17365d;&quot;&gt;
                &lt;tr&gt;
                  &lt;td style=&quot;padding:15px 16px; font-size:14px; line-height:22px; color:#405261;&quot;&gt;
                    Your request is currently &lt;strong&gt;awaiting authorization&lt;/strong&gt;.
                    Please wait while the request is reviewed.
                  &lt;/td&gt;
                &lt;/tr&gt;
              &lt;/table&gt;

              &lt;p style=&quot;margin:0 0 25px 0; font-size:14px; line-height:22px; color:#4f5963;&quot;&gt;
                Once your request has been reviewed, you will receive a separate email
                with the latest status and further instructions, if applicable.
              &lt;/p&gt;

              &lt;!-- Access Details Heading --&gt;
              &lt;p style=&quot;margin:0 0 12px 0; font-size:16px; line-height:24px; font-weight:bold; color:#17365d;&quot;&gt;
                Access Request Details
              &lt;/p&gt;

              &lt;!-- Details Table --&gt;
              &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; width=&quot;100%&quot;
                     style=&quot;border:1px solid #e1e5ea; border-radius:7px; overflow:hidden; font-size:14px;&quot;&gt;

                &lt;tr&gt;
                  &lt;td width=&quot;42%&quot; style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Project Name
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea; word-break:break-word;&quot;&gt;
                    {!Get_Production_Access_Config.Project_Name__c}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Ticket Number
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea; word-break:break-word;&quot;&gt;
                    {!Ticket_Number}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Reason
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea; word-break:break-word;&quot;&gt;
                    {!Reason}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Access Type
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    {!Access_Type}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Requested Start Time
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea; word-break:break-word;&quot;&gt;
                    {!Requested_Start}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Requested End Time
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea; word-break:break-word;&quot;&gt;
                    {!RequestedEndFormula}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e;&quot;&gt;
                    Duration
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px;&quot;&gt;
                    {!Duration} Hour(s)
                  &lt;/td&gt;
                &lt;/tr&gt;

              &lt;/table&gt;

              &lt;!-- Next Step --&gt;
              &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; width=&quot;100%&quot;
                     style=&quot;margin-top:28px; background-color:#f7f9fb; border-left:4px solid #7a8793;&quot;&gt;
                &lt;tr&gt;
                  &lt;td style=&quot;padding:14px 16px; font-size:13px; line-height:21px; color:#5c6670;&quot;&gt;
                    &lt;strong&gt;What happens next?&lt;/strong&gt;&lt;br&gt;
                    Your request will be reviewed by the respective Authorizer.
                    You do not need to take any action at this time.
                    You will be notified by email once the request has been approved or its status has been updated.
                  &lt;/td&gt;
                &lt;/tr&gt;
              &lt;/table&gt;

              &lt;!-- Closing --&gt;
              &lt;p style=&quot;margin:28px 0 0 0; font-size:14px; line-height:22px;&quot;&gt;
                Regards,&lt;br&gt;
                &lt;strong&gt;Production Access Team&lt;/strong&gt;
              &lt;/p&gt;

            &lt;/td&gt;
          &lt;/tr&gt;

          &lt;!-- Footer --&gt;
          &lt;tr&gt;
            &lt;td style=&quot;background-color:#f7f9fb; padding:15px 30px; text-align:center; border-top:1px solid #e5e8eb;&quot;&gt;
              &lt;span style=&quot;font-size:11px; color:#89929c;&quot;&gt;
                This is an automated email. Please do not reply to this message.
              &lt;/span&gt;
            &lt;/td&gt;
          &lt;/tr&gt;

        &lt;/table&gt;

      &lt;/td&gt;
    &lt;/tr&gt;
  &lt;/table&gt;

&lt;/div&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>ApprovalOrRejectionEmailBodyTemplate</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;div style=&quot;margin:0; padding:0; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif; color:#2f3a45;&quot;&gt;

  &lt;!-- Main Container --&gt;
  &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; width=&quot;100%&quot; style=&quot;background-color:#f4f6f8; margin:0; padding:0;&quot;&gt;
    &lt;tr&gt;
      &lt;td align=&quot;center&quot; style=&quot;padding:30px 15px;&quot;&gt;

        &lt;!-- Email Card --&gt;
        &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; width=&quot;100%&quot;
               style=&quot;max-width:650px; background-color:#ffffff; border-radius:10px; overflow:hidden;&quot;&gt;

          &lt;!-- Header --&gt;
          &lt;tr&gt;
            &lt;td style=&quot;background-color:#17365d; padding:24px 30px; text-align:center;&quot;&gt;
              &lt;div style=&quot;font-size:22px; line-height:30px; font-weight:bold; color:#ffffff;&quot;&gt;
                Production Access Request
              &lt;/div&gt;
              &lt;div style=&quot;font-size:13px; line-height:20px; color:#dbe7f5; margin-top:5px;&quot;&gt;
                {!Get_Production_Access_Config.Project_Name__c}
              &lt;/div&gt;
            &lt;/td&gt;
          &lt;/tr&gt;

          &lt;!-- Content --&gt;
          &lt;tr&gt;
            &lt;td style=&quot;padding:30px;&quot;&gt;

              &lt;p style=&quot;margin:0 0 18px 0; font-size:15px; line-height:24px;&quot;&gt;
                Hello,
              &lt;/p&gt;

              &lt;p style=&quot;margin:0 0 24px 0; font-size:15px; line-height:24px;&quot;&gt;
                A new request for
                &lt;strong&gt;{!Get_Production_Access_Config.Project_Name__c}&lt;/strong&gt;
                Production Access has been submitted. Please review the request details below.
              &lt;/p&gt;

              &lt;!-- Request Details --&gt;
              &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; width=&quot;100%&quot;
                     style=&quot;border:1px solid #e1e5ea; border-radius:7px; overflow:hidden; font-size:14px;&quot;&gt;

                &lt;tr&gt;
                  &lt;td width=&quot;42%&quot; style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Project Name
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    {!Get_Production_Access_Config.Project_Name__c}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Developer Name
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    {!Developer_Name}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Developer Email
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea; word-break:break-word;&quot;&gt;
                    {!Developer_Email}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Ticket Number
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    {!Ticket_Number}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Reason
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea; word-break:break-word;&quot;&gt;
                    {!Reason}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Access Type
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    {!Access_Type}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Requested Start Time
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    {!Requested_Start}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    Expiration Time
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px; border-bottom:1px solid #e1e5ea;&quot;&gt;
                    {!RequestedEndFormula}
                  &lt;/td&gt;
                &lt;/tr&gt;

                &lt;tr&gt;
                  &lt;td style=&quot;padding:12px 14px; background-color:#f7f9fb; font-weight:bold; color:#45515e;&quot;&gt;
                    Duration
                  &lt;/td&gt;
                  &lt;td style=&quot;padding:12px 14px;&quot;&gt;
                    {!Duration} Hour(s)
                  &lt;/td&gt;
                &lt;/tr&gt;

              &lt;/table&gt;

              &lt;!-- Action Section --&gt;
              &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; width=&quot;100%&quot; style=&quot;margin-top:30px;&quot;&gt;
                &lt;tr&gt;
                  &lt;td style=&quot;text-align:center;&quot;&gt;

                    &lt;p style=&quot;margin:0 0 20px 0; font-size:15px; line-height:22px; font-weight:bold; color:#2f3a45;&quot;&gt;
                      Please review the request and select an action:
                    &lt;/p&gt;

                    &lt;!-- Approve Button --&gt;
                    &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;margin:0 auto 12px auto;&quot;&gt;
                      &lt;tr&gt;
                        &lt;td align=&quot;center&quot; bgcolor=&quot;#2e7d32&quot; style=&quot;border-radius:6px;&quot;&gt;
                          &lt;a href=&quot;https://{!ProductionAccessSiteBaseURL}/services/apexrest/productionAccess/approveReject/?token={!Encode_Request_Token.token}&amp;amp;action=Approve&quot; 
target=&quot;_blank&quot; style=&quot;display:inline-block; padding:13px 40px; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:6px; background-color:#2e7d32;&quot;&gt; 
Approve Request 
&lt;/a&gt;
                        &lt;/td&gt;
                      &lt;/tr&gt;
                    &lt;/table&gt;

                    &lt;!-- Reject Button --&gt;
                    &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;margin:0 auto;&quot;&gt;
                      &lt;tr&gt;
                        &lt;td align=&quot;center&quot; bgcolor=&quot;#c62828&quot; style=&quot;border-radius:6px;&quot;&gt;
                          &lt;a href=&quot;https://{!ProductionAccessSiteBaseURL}/services/apexrest/productionAccess/approveReject/?token={!Encode_Request_Token.token}&amp;amp;action=Reject&quot;
target=&quot;_blank&quot; style=&quot;display:inline-block; padding:13px 40px; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:6px; background-color:#c62828;&quot;&gt; 
Reject Request 
&lt;/a&gt;
                        &lt;/td&gt;
                      &lt;/tr&gt;
                    &lt;/table&gt;

                  &lt;/td&gt;
                &lt;/tr&gt;
              &lt;/table&gt;

              &lt;!-- Note --&gt;
              &lt;table role=&quot;presentation&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; width=&quot;100%&quot;
                     style=&quot;margin-top:28px; background-color:#f7f9fb; border-left:4px solid #17365d;&quot;&gt;
                &lt;tr&gt;
                  &lt;td style=&quot;padding:13px 15px; font-size:13px; line-height:20px; color:#5c6670;&quot;&gt;
                    Clicking either button will process the request directly.
                    You do not need to log in to Salesforce to approve or reject this request.
                  &lt;/td&gt;
                &lt;/tr&gt;
              &lt;/table&gt;

              &lt;!-- Footer --&gt;
              &lt;p style=&quot;margin:30px 0 0 0; font-size:14px; line-height:22px;&quot;&gt;
                Regards,&lt;br&gt;
                &lt;strong&gt;Production Access Team&lt;/strong&gt;
              &lt;/p&gt;

            &lt;/td&gt;
          &lt;/tr&gt;

          &lt;!-- Bottom Footer --&gt;
          &lt;tr&gt;
            &lt;td style=&quot;background-color:#f7f9fb; padding:15px 30px; text-align:center; border-top:1px solid #e5e8eb;&quot;&gt;
              &lt;span style=&quot;font-size:11px; color:#89929c;&quot;&gt;
                This is an automated email. Please do not reply to this message.
              &lt;/span&gt;
            &lt;/td&gt;
          &lt;/tr&gt;

        &lt;/table&gt;

      &lt;/td&gt;
    &lt;/tr&gt;
  &lt;/table&gt;

&lt;/div&gt;</text>
